{
  "name": "strapi-blog-editor",
  "version": "0.2.0",
  "description": "Web editor for Brandeis Strapi blog posts with live Gatsby-style preview",
  "private": true,
  "author": {
    "name": "Brandeis Consulting"
  },
  "scripts": {
    "dev": "concurrently -n vite,api -c green,blue \"vite\" \"tsx watch server/index.ts\"",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@types/multer": "^2.1.0",
    "@uiw/react-codemirror": "^4.23.6",
    "cookie-parser": "^1.4.7",
    "diff": "^7.0.0",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "highlight.js": "^11.10.0",
    "multer": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/diff": "^7.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "sass": "^1.81.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
