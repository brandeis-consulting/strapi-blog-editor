{
  "name": "strapi-blog-editor",
  "version": "0.1.0",
  "description": "Electron desktop editor for Brandeis Strapi blog posts with live Gatsby-style preview",
  "private": true,
  "author": {
    "name": "Brandeis Consulting"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "concurrently -n vite,api -c green,blue \"vite --mode web\" \"tsx watch server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --mode web && tsc -p tsconfig.server.json",
    "start:web": "node dist-server/index.js",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:installer": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@uiw/react-codemirror": "^4.23.6",
    "cookie-parser": "^1.4.7",
    "diff": "^7.0.0",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "highlight.js": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/diff": "^7.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "electron": "^33.2.1",
    "electron-builder": "24.13.3",
    "sass": "^1.81.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "de.brandeis.blogeditor",
    "productName": "Brandeis Blog Editor",
    "asar": true,
    "directories": {
      "output": "dist-build",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Brandeis-Blog-Editor-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Brandeis Blog Editor"
    },
    "portable": {
      "artifactName": "Brandeis-Blog-Editor-${version}-portable.${ext}"
    }
  }
}
