# Optional: override the Strapi base URL (default: https://cms.brandeis.de)
# STRAPI_URL=https://cms.brandeis.de

# Optional: Strapi media library folder ID for paste-uploads (leave unset for root)
# UPLOAD_FOLDER_ID=42

# Vorschauseite im Gatsby-Projekt. Der Editor bettet sie als iframe ein und
# schickt ihr den Entwurf per postMessage — dadurch rendert die Vorschau mit
# denselben Komponenten wie die Live-Site.
#
# Lokale Entwicklung gegen ein laufendes `gatsby develop`:
#   PREVIEW_URL=http://localhost:8000/blog-preview/
# PREVIEW_URL=https://www.brandeis.de/blog-preview/
